
>>SOURCE FORMAT FREE

IDENTIFICATION DIVISION.
PROGRAM-ID. BANKING-TRANSACTION-PROCESSOR.
AUTHOR. DANIEL SIMONETTA.
DATE-WRITTEN. 20261111.

ENVIRONMENT DIVISION.

DATA DIVISION.

WORKING-STORAGE SECTION.

01 WS-ACCOUNT-TABLE.
   05 WS-ACCOUNT OCCURS 5 TIMES.
      10 WS-ACCOUNT-NUMBER PIC X(6).
      10 WS-ACCOUNT-NAME PIC X(30).
      10 WS-ACCOUNT-PIN PIC X(4).
      10 WS-ACCOUNT-BALANCE PIC S9(10)V99 COMP-3.
      10 WS-ACCOUNT-STATUS PIC X.

01 WS-TRANSACTION-LOG.
   05 WS-TRANSACTION OCCURS 100 TIMES.
      10 WS-TRANSACTION-ID PIC 9(6).
      10 WS-TRANSACTION-TYPE PIC X(12).
      10 WS-TRANSACTION-FROM PIC X(6).
      10 WS-TRANSACTION-TO PIC X(6).
      10 WS-TRANSACTION-AMOUNT PIC 9(10)V99 COMP-3.
      10 WS-TRANSACTION-DATE PIC X(8).

01 WS-ACCOUNT-COUNT PIC 9 VALUE 5.
01 WS-TRANSACTION-COUNT PIC 9(3) VALUE 0.
01 WS-TRANSACTION-COUNTER PIC 9(6) VALUE 0.

01 WS-CURRENT-ACCOUNT PIC 9.
01 WS-DESTINATION-ACCOUNT PIC 9.
01 WS-SEARCH-INDEX PIC 9.
01 WS-LOOP-INDEX PIC 9(3).

01 WS-LOGIN-ACCOUNT PIC X(6).
01 WS-LOGIN-PIN PIC X(4).
01 WS-DESTINATION-NUMBER PIC X(6).

01 WS-MENU-OPTION PIC X.
01 WS-AMOUNT-INPUT PIC X(20).
01 WS-AMOUNT PIC 9(10)V99 COMP-3.

01 WS-LOGIN-ATTEMPTS PIC 9 VALUE 0.
01 WS-LOGIN-VALID PIC X VALUE "N".
01 WS-APPLICATION-RUNNING PIC X VALUE "Y".
01 WS-OPERATION-VALID PIC X VALUE "N".

01 WS-CURRENT-DATE PIC X(8).

01 WS-DISPLAY-BALANCE PIC Z,ZZZ,ZZZ,ZZ9.99.
01 WS-DISPLAY-AMOUNT PIC Z,ZZZ,ZZZ,ZZ9.99.
01 WS-DISPLAY-AVAILABLE PIC Z,ZZZ,ZZZ,ZZ9.99.

01 WS-ERROR-MESSAGE PIC X(60).

01 WS-YES-NO PIC X.

PROCEDURE DIVISION.

MAIN-PROCESS.

    PERFORM INITIALIZE-SYSTEM

    PERFORM UNTIL WS-APPLICATION-RUNNING = "N"

        PERFORM AUTHENTICATION

        IF WS-LOGIN-VALID = "Y"
            PERFORM BANKING-MENU
        ELSE
            MOVE "N" TO WS-APPLICATION-RUNNING
        END-IF

    END-PERFORM

    DISPLAY SPACE
    DISPLAY "=========================================="
    DISPLAY " BANKING SYSTEM SHUTDOWN"
    DISPLAY " SESSION CLOSED SUCCESSFULLY"
    DISPLAY "=========================================="

    STOP RUN.

INITIALIZE-SYSTEM.

    MOVE "100001" TO WS-ACCOUNT-NUMBER(1)
    MOVE "JOHN SMITH" TO WS-ACCOUNT-NAME(1)
    MOVE "1234" TO WS-ACCOUNT-PIN(1)
    MOVE 15000.00 TO WS-ACCOUNT-BALANCE(1)
    MOVE "A" TO WS-ACCOUNT-STATUS(1)

    MOVE "100002" TO WS-ACCOUNT-NUMBER(2)
    MOVE "MARY JOHNSON" TO WS-ACCOUNT-NAME(2)
    MOVE "2345" TO WS-ACCOUNT-PIN(2)
    MOVE 25000.00 TO WS-ACCOUNT-BALANCE(2)
    MOVE "A" TO WS-ACCOUNT-STATUS(2)

    MOVE "100003" TO WS-ACCOUNT-NUMBER(3)
    MOVE "ROBERT BROWN" TO WS-ACCOUNT-NAME(3)
    MOVE "3456" TO WS-ACCOUNT-PIN(3)
    MOVE 8500.50 TO WS-ACCOUNT-BALANCE(3)
    MOVE "A" TO WS-ACCOUNT-STATUS(3)

    MOVE "100004" TO WS-ACCOUNT-NUMBER(4)
    MOVE "SARAH DAVIS" TO WS-ACCOUNT-NAME(4)
    MOVE "4567" TO WS-ACCOUNT-PIN(4)
    MOVE 42000.75 TO WS-ACCOUNT-BALANCE(4)
    MOVE "A" TO WS-ACCOUNT-STATUS(4)

    MOVE "100005" TO WS-ACCOUNT-NUMBER(5)
    MOVE "MICHAEL WILSON" TO WS-ACCOUNT-NAME(5)
    MOVE "5678" TO WS-ACCOUNT-PIN(5)
    MOVE 1200.00 TO WS-ACCOUNT-BALANCE(5)
    MOVE "A" TO WS-ACCOUNT-STATUS(5)

    ACCEPT WS-CURRENT-DATE FROM DATE YYYYMMDD

    DISPLAY SPACE
    DISPLAY "=========================================="
    DISPLAY " BANKING TRANSACTION PROCESSOR"
    DISPLAY " COBOL CORE BANKING SIMULATOR"
    DISPLAY "==========================================".

AUTHENTICATION.

    MOVE "N" TO WS-LOGIN-VALID
    MOVE 0 TO WS-LOGIN-ATTEMPTS

    PERFORM UNTIL WS-LOGIN-VALID = "Y"
        OR WS-LOGIN-ATTEMPTS >= 3

        DISPLAY SPACE
        DISPLAY "------------------------------------------"
        DISPLAY "              BANK LOGIN"
        DISPLAY "------------------------------------------"

        DISPLAY "ACCOUNT NUMBER: " WITH NO ADVANCING
        ACCEPT WS-LOGIN-ACCOUNT

        DISPLAY "SECURITY PIN: " WITH NO ADVANCING
        ACCEPT WS-LOGIN-PIN

        MOVE 0 TO WS-CURRENT-ACCOUNT

        PERFORM VARYING WS-SEARCH-INDEX FROM 1 BY 1
            UNTIL WS-SEARCH-INDEX > WS-ACCOUNT-COUNT

            IF WS-LOGIN-ACCOUNT =
                WS-ACCOUNT-NUMBER(WS-SEARCH-INDEX)
                AND WS-LOGIN-PIN =
                WS-ACCOUNT-PIN(WS-SEARCH-INDEX)
                AND WS-ACCOUNT-STATUS(WS-SEARCH-INDEX) = "A"

                MOVE WS-SEARCH-INDEX TO WS-CURRENT-ACCOUNT
                MOVE "Y" TO WS-LOGIN-VALID

            END-IF

        END-PERFORM

        IF WS-LOGIN-VALID = "Y"
            DISPLAY SPACE
            DISPLAY "AUTHENTICATION SUCCESSFUL."
            DISPLAY "WELCOME, "
                WS-ACCOUNT-NAME(WS-CURRENT-ACCOUNT)
        ELSE
            ADD 1 TO WS-LOGIN-ATTEMPTS
            DISPLAY "INVALID CREDENTIALS OR INACTIVE ACCOUNT."
            DISPLAY "ATTEMPTS REMAINING: "
                3 - WS-LOGIN-ATTEMPTS
        END-IF

    END-PERFORM

    IF WS-LOGIN-VALID = "N"
        DISPLAY SPACE
        DISPLAY "ACCESS DENIED."
        DISPLAY "MAXIMUM LOGIN ATTEMPTS EXCEEDED."
    END-IF.

BANKING-MENU.

    PERFORM UNTIL WS-APPLICATION-RUNNING = "N"
        OR WS-LOGIN-VALID = "N"

        DISPLAY SPACE
        DISPLAY "=========================================="
        DISPLAY "              BANKING MENU"
        DISPLAY "=========================================="
        DISPLAY "CUSTOMER: "
            WS-ACCOUNT-NAME(WS-CURRENT-ACCOUNT)
        DISPLAY "ACCOUNT: "
            WS-ACCOUNT-NUMBER(WS-CURRENT-ACCOUNT)
        DISPLAY "------------------------------------------"
        DISPLAY "1. ACCOUNT BALANCE"
        DISPLAY "2. CASH DEPOSIT"
        DISPLAY "3. CASH WITHDRAWAL"
        DISPLAY "4. ACCOUNT TRANSFER"
        DISPLAY "5. TRANSACTION HISTORY"
        DISPLAY "6. LOGOUT"
        DISPLAY "0. EXIT SYSTEM"
        DISPLAY "------------------------------------------"
        DISPLAY "SELECT OPTION: " WITH NO ADVANCING

        ACCEPT WS-MENU-OPTION

        EVALUATE WS-MENU-OPTION
            WHEN "1"
                PERFORM DISPLAY-BALANCE
            WHEN "2"
                PERFORM CASH-DEPOSIT
            WHEN "3"
                PERFORM CASH-WITHDRAWAL
            WHEN "4"
                PERFORM ACCOUNT-TRANSFER
            WHEN "5"
                PERFORM TRANSACTION-HISTORY
            WHEN "6"
                MOVE "N" TO WS-LOGIN-VALID
                DISPLAY "SESSION TERMINATED."
            WHEN "0"
                MOVE "N" TO WS-APPLICATION-RUNNING
                MOVE "N" TO WS-LOGIN-VALID
            WHEN OTHER
                DISPLAY "INVALID MENU OPTION."
        END-EVALUATE

    END-PERFORM.

DISPLAY-BALANCE.

    MOVE WS-ACCOUNT-BALANCE(WS-CURRENT-ACCOUNT)
        TO WS-DISPLAY-BALANCE

    DISPLAY SPACE
    DISPLAY "------------------------------------------"
    DISPLAY "             ACCOUNT BALANCE"
    DISPLAY "------------------------------------------"
    DISPLAY "ACCOUNT HOLDER: "
        WS-ACCOUNT-NAME(WS-CURRENT-ACCOUNT)
    DISPLAY "ACCOUNT NUMBER: "
        WS-ACCOUNT-NUMBER(WS-CURRENT-ACCOUNT)
    DISPLAY "AVAILABLE BALANCE: $"
        WS-DISPLAY-BALANCE
    DISPLAY "------------------------------------------".

CASH-DEPOSIT.

    DISPLAY SPACE
    DISPLAY "------------------------------------------"
    DISPLAY "                CASH DEPOSIT"
    DISPLAY "------------------------------------------"

    PERFORM READ-AMOUNT

    IF WS-OPERATION-VALID = "Y"

        IF WS-TRANSACTION-COUNT >= 100
            DISPLAY "TRANSACTION LOG CAPACITY EXCEEDED."
        ELSE
            ADD WS-AMOUNT
                TO WS-ACCOUNT-BALANCE(WS-CURRENT-ACCOUNT)

            MOVE "DEPOSIT" TO WS-ERROR-MESSAGE
            PERFORM RECORD-TRANSACTION

            MOVE WS-AMOUNT TO WS-DISPLAY-AMOUNT

            DISPLAY "DEPOSIT SUCCESSFUL."
            DISPLAY "AMOUNT: $" WS-DISPLAY-AMOUNT

            PERFORM DISPLAY-BALANCE
        END-IF

    END-IF.

CASH-WITHDRAWAL.

    DISPLAY SPACE
    DISPLAY "------------------------------------------"
    DISPLAY "              CASH WITHDRAWAL"
    DISPLAY "------------------------------------------"

    PERFORM READ-AMOUNT

    IF WS-OPERATION-VALID = "Y"

        IF WS-TRANSACTION-COUNT >= 100
            DISPLAY "TRANSACTION LOG CAPACITY EXCEEDED."
        ELSE
            IF WS-AMOUNT >
                WS-ACCOUNT-BALANCE(WS-CURRENT-ACCOUNT)

                DISPLAY "TRANSACTION DECLINED."
                DISPLAY "INSUFFICIENT FUNDS."

            ELSE
                SUBTRACT WS-AMOUNT
                    FROM WS-ACCOUNT-BALANCE(WS-CURRENT-ACCOUNT)

                MOVE "WITHDRAWAL" TO WS-ERROR-MESSAGE
                PERFORM RECORD-TRANSACTION

                MOVE WS-AMOUNT TO WS-DISPLAY-AMOUNT

                DISPLAY "WITHDRAWAL SUCCESSFUL."
                DISPLAY "AMOUNT: $" WS-DISPLAY-AMOUNT

                PERFORM DISPLAY-BALANCE

            END-IF
        END-IF

    END-IF.

ACCOUNT-TRANSFER.

    DISPLAY SPACE
    DISPLAY "------------------------------------------"
    DISPLAY "              ACCOUNT TRANSFER"
    DISPLAY "------------------------------------------"

    DISPLAY "DESTINATION ACCOUNT: " WITH NO ADVANCING
    ACCEPT WS-DESTINATION-NUMBER

    MOVE 0 TO WS-DESTINATION-ACCOUNT

    PERFORM VARYING WS-SEARCH-INDEX FROM 1 BY 1
        UNTIL WS-SEARCH-INDEX > WS-ACCOUNT-COUNT

        IF WS-DESTINATION-NUMBER =
            WS-ACCOUNT-NUMBER(WS-SEARCH-INDEX)
            AND WS-ACCOUNT-STATUS(WS-SEARCH-INDEX) = "A"

            MOVE WS-SEARCH-INDEX
                TO WS-DESTINATION-ACCOUNT

        END-IF

    END-PERFORM

    IF WS-DESTINATION-ACCOUNT = 0

        DISPLAY "DESTINATION ACCOUNT NOT FOUND."

    ELSE

        IF WS-DESTINATION-ACCOUNT = WS-CURRENT-ACCOUNT

            DISPLAY "INVALID TRANSFER."
            DISPLAY "SOURCE AND DESTINATION MUST DIFFER."

        ELSE

            PERFORM READ-AMOUNT

            IF WS-OPERATION-VALID = "Y"

                IF WS-TRANSACTION-COUNT >= 100

                    DISPLAY "TRANSACTION LOG CAPACITY EXCEEDED."

                ELSE

                    IF WS-AMOUNT >
                        WS-ACCOUNT-BALANCE(WS-CURRENT-ACCOUNT)

                        DISPLAY "TRANSFER DECLINED."
                        DISPLAY "INSUFFICIENT FUNDS."

                    ELSE

                        SUBTRACT WS-AMOUNT
                            FROM WS-ACCOUNT-BALANCE(
                                WS-CURRENT-ACCOUNT)

                        ADD WS-AMOUNT
                            TO WS-ACCOUNT-BALANCE(
                                WS-DESTINATION-ACCOUNT)

                        MOVE "TRANSFER" TO WS-ERROR-MESSAGE
                        PERFORM RECORD-TRANSACTION

                        MOVE WS-AMOUNT TO WS-DISPLAY-AMOUNT

                        DISPLAY "TRANSFER COMPLETED."
                        DISPLAY "AMOUNT: $" WS-DISPLAY-AMOUNT
                        DISPLAY "DESTINATION: "
                            WS-ACCOUNT-NAME(WS-DESTINATION-ACCOUNT)

                        PERFORM DISPLAY-BALANCE

                    END-IF

                END-IF

            END-IF

        END-IF

    END-IF.

READ-AMOUNT.

    MOVE "N" TO WS-OPERATION-VALID
    MOVE 0 TO WS-AMOUNT

    DISPLAY "ENTER AMOUNT: $"
        WITH NO ADVANCING

    ACCEPT WS-AMOUNT-INPUT

    IF WS-AMOUNT-INPUT = SPACES

        DISPLAY "INVALID AMOUNT."

    ELSE

        IF FUNCTION TEST-NUMVAL(WS-AMOUNT-INPUT) NOT = 0

            DISPLAY "INVALID NUMERIC FORMAT."

        ELSE

            COMPUTE WS-AMOUNT =
                FUNCTION NUMVAL(WS-AMOUNT-INPUT)

            IF WS-AMOUNT <= 0

                DISPLAY "AMOUNT MUST BE GREATER THAN ZERO."

            ELSE

                MOVE "Y" TO WS-OPERATION-VALID

            END-IF

        END-IF

    END-IF.

RECORD-TRANSACTION.

    ADD 1 TO WS-TRANSACTION-COUNT
    ADD 1 TO WS-TRANSACTION-COUNTER

    MOVE WS-TRANSACTION-COUNTER
        TO WS-TRANSACTION-ID(WS-TRANSACTION-COUNT)

    MOVE WS-ERROR-MESSAGE
        TO WS-TRANSACTION-TYPE(WS-TRANSACTION-COUNT)

    MOVE WS-ACCOUNT-NUMBER(WS-CURRENT-ACCOUNT)
        TO WS-TRANSACTION-FROM(WS-TRANSACTION-COUNT)

    MOVE SPACES
        TO WS-TRANSACTION-TO(WS-TRANSACTION-COUNT)

    IF WS-ERROR-MESSAGE = "TRANSFER"
        MOVE WS-ACCOUNT-NUMBER(WS-DESTINATION-ACCOUNT)
            TO WS-TRANSACTION-TO(WS-TRANSACTION-COUNT)
    END-IF

    MOVE WS-AMOUNT
        TO WS-TRANSACTION-AMOUNT(WS-TRANSACTION-COUNT)

    MOVE WS-CURRENT-DATE
        TO WS-TRANSACTION-DATE(WS-TRANSACTION-COUNT).

TRANSACTION-HISTORY.

    DISPLAY SPACE
    DISPLAY "=========================================="
    DISPLAY "            TRANSACTION HISTORY"
    DISPLAY "=========================================="

    IF WS-TRANSACTION-COUNT = 0

        DISPLAY "NO TRANSACTIONS AVAILABLE."

    ELSE

        PERFORM VARYING WS-LOOP-INDEX FROM 1 BY 1
            UNTIL WS-LOOP-INDEX > WS-TRANSACTION-COUNT

            IF WS-TRANSACTION-FROM(WS-LOOP-INDEX) =
                WS-ACCOUNT-NUMBER(WS-CURRENT-ACCOUNT)

                OR WS-TRANSACTION-TO(WS-LOOP-INDEX) =
                WS-ACCOUNT-NUMBER(WS-CURRENT-ACCOUNT)

                MOVE WS-TRANSACTION-AMOUNT(WS-LOOP-INDEX)
                    TO WS-DISPLAY-AMOUNT

                DISPLAY "------------------------------------------"
                DISPLAY "TRANSACTION ID: "
                    WS-TRANSACTION-ID(WS-LOOP-INDEX)
                DISPLAY "TYPE: "
                    WS-TRANSACTION-TYPE(WS-LOOP-INDEX)
                DISPLAY "DATE: "
                    WS-TRANSACTION-DATE(WS-LOOP-INDEX)
                DISPLAY "FROM: "
                    WS-TRANSACTION-FROM(WS-LOOP-INDEX)
                DISPLAY "TO: "
                    WS-TRANSACTION-TO(WS-LOOP-INDEX)
                DISPLAY "AMOUNT: $" WS-DISPLAY-AMOUNT

            END-IF

        END-PERFORM

    END-IF

    DISPLAY "==========================================".

